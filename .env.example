# Leave blank for local-only use. Set a long random value for a shared deployment.
BPSD_ALIGNER_ACCESS_TOKEN=

# Preferred for shared multi-user deployments. Store this JSON outside Git.
# Values may be plaintext or sha256:<64 lowercase hex characters>.
# Example .bpsd-users.json: {"reviewer-a":"sha256:<token digest>"}
BPSD_ALIGNER_USERS_FILE=/run/secrets/bpsd-users.json
BPSD_ALIGNER_DEPLOYMENT_MODE=production

# Use the same random value (at least 32 bytes) on every server that must
# exchange resume checkpoint ZIPs.
BPSD_ALIGNER_CHECKPOINT_SECRET=replace-with-at-least-32-random-bytes

# Persist this path as a volume in production.
BPSD_ALIGNER_JOB_DIR=/var/lib/bpsd-aligner

# Opt-in cleanup; completed inactive jobs older than this are deleted.
BPSD_ALIGNER_JOB_RETENTION_HOURS=168

BPSD_ALIGNER_MAX_CONCURRENT_JOBS=1
BPSD_ALIGNER_MAX_PAGES=200
BPSD_ALIGNER_MAX_STORAGE_BYTES=21474836480
BPSD_ALIGNER_MAX_PDF_PAGES=500
BPSD_ALIGNER_MAX_PDF_RENDER_PIXELS=100000000
BPSD_ALIGNER_WORKER_QUEUE_TIMEOUT=3600
